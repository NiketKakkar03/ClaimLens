{
  "title": "Claims Intelligence Overview",
  "uid": "claims-overview",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Prediction request rate", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(claims_prediction_requests_total[1m])) by (status)", "legendFormat": "{{status}}"}]},
    {"id": 2, "title": "Prediction p95 latency", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(claims_prediction_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]},
    {"id": 3, "title": "Successful predictions", "type": "stat", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6}, "targets": [{"expr": "sum(claims_prediction_requests_total{status=\"success\"})"}]},
    {"id": 4, "title": "Unavailable predictions", "type": "stat", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6}, "targets": [{"expr": "sum(claims_prediction_requests_total{status=\"unavailable\"})"}]},
    {"id": 5, "title": "Target status", "type": "stat", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6}, "targets": [{"expr": "up{job=\"claims-inference\"}"}]}
  ]
}
