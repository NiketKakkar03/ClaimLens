FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends openjdk-21-jre \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY docker/requirements-spark.txt ./docker/requirements-spark.txt
RUN pip install --no-cache-dir -r docker/requirements-spark.txt
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps --no-build-isolation . \
    && useradd --create-home --uid 10001 sparkuser \
    && mkdir -p /app/data/lakehouse \
    && mkdir -p /home/sparkuser/.ivy2.5.2 \
    && chown -R sparkuser:sparkuser /app/data /home/sparkuser

USER sparkuser
CMD ["claims-intelligence", "build-lakehouse"]
